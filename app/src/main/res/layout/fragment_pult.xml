<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117"
    android:padding="12dp">

    <!-- Верхняя панель: IP и порт -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etHost"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="2"
            android:backgroundTint="#30363D"
            android:hint="IP-адрес"
            android:textColor="#C9D1D9"
            android:textColorHint="#8B949E"
            android:text="127.0.0.1"
            android:inputType="text" />

        <EditText
            android:id="@+id/etPort"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#30363D"
            android:hint="Порт"
            android:textColor="#C9D1D9"
            android:textColorHint="#8B949E"
            android:text="4444"
            android:inputType="number" />
    </LinearLayout>

    <Button
        android:id="@+id/btnConnect"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:backgroundTint="#238636"
        android:text="ПОДКЛЮЧИТЬСЯ"
        android:textColor="#FFFFFF" />

    <!-- Быстрые команды -->
    <HorizontalScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnStream"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#8957E5"
                android:text="/stream"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnScreen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#1F6FEB"
                android:text="/screen"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnProc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#1F6FEB"
                android:text="/proc"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnLock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#DA3633"
                android:text="/lock"
                android:textColor="#FFFFFF" />

            <Button
                android:id="@+id/btnUnlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="#DA3633"
                android:text="/unlock"
                android:textColor="#FFFFFF" />
        </LinearLayout>
    </HorizontalScrollView>

    <!-- Окно вывода / скриншот -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:background="#161B22"
        android:padding="8dp">

        <ScrollView
            android:id="@+id/scrollView"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <TextView
                android:id="@+id/tvOutput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#58A6FF"
                android:textIsSelectable="true"
                android:fontFamily="monospace"
                android:textSize="12sp" />
        </ScrollView>

        <ImageView
            android:id="@+id/ivScreenshot"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="matrix"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Строка ввода команды (снизу) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/etCommand"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:backgroundTint="#30363D"
            android:hint="Введите команду..."
            android:textColor="#C9D1D9"
            android:textColorHint="#8B949E" />

        <Button
            android:id="@+id/btnSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:backgroundTint="#238636"
            android:text="ОТПРАВИТЬ"
            android:textColor="#FFFFFF" />
    </LinearLayout>
</LinearLayout>
