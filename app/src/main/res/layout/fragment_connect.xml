<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0D1117"
    android:gravity="center"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="СПИСОК УСТРОЙСТВ"
        android:textColor="#58A6FF"
        android:textSize="20sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Здесь будут отображаться ПК, на которых\nзапущен наш сервер."
        android:textColor="#8B949E"
        android:textAlignment="center"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnConnectManual"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:backgroundTint="#238636"
        android:text="ОБНОВИТЬ СПИСОК"
        android:textColor="#FFFFFF" />

</LinearLayout>
